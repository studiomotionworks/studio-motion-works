{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "vercel-proxy/proxy-status.txt",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://motion-studio.motionworks-studio.workers.dev/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [{ "key": "X-Motionworks-Backend", "value": "cloudflare" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/portal-access-key/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
